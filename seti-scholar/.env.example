# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seti_scholar"

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-secret"
AUTH_TRUST_HOST="true"

# AI providers (optional — the tutor falls back to a built-in offline tutor when unset).
# Set one or both; choose the active provider in Settings → AI Configuration.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Secret used to authorize the scheduled spaced-repetition/reminder job endpoint.
JOBS_SECRET="replace-me-with-a-random-job-secret"

# Base URL of the app (used by the job runner script)
APP_URL="http://localhost:3000"
